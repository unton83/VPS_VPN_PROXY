# ── WireGuard Panel (wg-easy) configuration ─────────────────────────────
# These variables are read by docker compose from this file (.env)
# The actual .env file is generated automatically by deploy.sh
# and contains a randomly generated admin password.

# Unattended setup — applied ONLY on first container start.
# After the first start the setup is disabled and these variables are ignored.
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PASSWORD=change-me
# Public host clients will connect to (server IP or domain) and WireGuard listen port
INIT_HOST=vpn.example.com
INIT_PORT=51820
INIT_DNS=1.1.1.1,8.8.8.8

# Optional: enable experimental AmneziaWG (obfuscation against DPI).
# Requires the amneziawg kernel module installed on the host.
# If the module is missing, wg-easy falls back to standard WireGuard.
EXPERIMENTAL_AWG=false

# Panel accepts plain HTTP on 127.0.0.1:51821.
# External access is only via the nginx TLS reverse proxy at https://DOMAIN:8443
INSECURE=true

# Timezone
TZ=Europe/Moscow