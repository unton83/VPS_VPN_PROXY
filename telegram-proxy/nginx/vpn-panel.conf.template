# Port 8443 — WireGuard Panel (wg-easy) behind TLS
# Generated from vpn-panel.conf.template by deploy.sh.
# Proxy target: wg-easy container via the shared "revers-proxy-net" Docker network.
# Same certificate as the main domain (single-domain setup).

# "Connection" must follow the "Upgrade" request header, otherwise the panel
# WebSocket (live updates) breaks for plain HTTP requests
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker embedded DNS. Lets nginx resolve "wg-easy" at request time instead of
# at start/reload time — without it nginx fails with
# `host not found in upstream "wg-easy"` whenever the panel container is down.
resolver 127.0.0.11 valid=30s ipv6=off;

server {
    listen 8443 ssl;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSLPanel:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Disable client body buffering and proxy timeouts tuned for a web panel
    client_max_body_size 10m;

    location / {
        # Hostname is resolved per request via the resolver above, so nginx
        # starts and reloads even while the wg-easy container is not running
        set $wg_upstream http://wg-easy:51821;
        proxy_pass $wg_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket / SSE support
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    access_log /var/log/nginx/wgpanel_access.log;
    error_log  /var/log/nginx/wgpanel_error.log;
}